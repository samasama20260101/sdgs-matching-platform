{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 明日もsamasama のアプリ(Next.js)を Cloudflare Workers で動かす設定。
  // OpenNext が `.open-next/worker.js` を作り、worker/index.ts がそれを包んで毎日の自動処理(Cron Triggers)を足す。
  //
  // 環境は staging(dev ブランチ)と production(main ブランチ)。named environment は vars と binding を
  // 引き継がないので、それぞれに書く。秘密の値は `wrangler secret put <名前> --env <環境>` で入れる
  // (一覧は docs/operations.md の「環境変数」)。ここには秘密でない値だけを書く。
  "account_id": "cfafb5269cd2d82e97713fdbdd3676bf",
  "main": "worker/index.ts",
  "name": "samasama-app",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "samasama-app-staging",
      "vars": {
        "APP_ENV": "staging",
        // 知らせのメールに書くアプリの URL(既定は本番の https://app.samasama.site)
        "APP_ORIGIN": "https://samasama-app-staging.samasama.workers.dev",
        // 知らせのメールの差出人(本番 v1 と同じ Resend のチーム ocn・同じアドレス)。鍵は Secret の RESEND_API_KEY
        // (Staging は送信専用の鍵「workers-staging」、samasama.site だけに送れる)。鍵がなければ送らない
        "NOTIFY_FROM_EMAIL": "明日もsamasama <no-reply@samasama.site>",
        // AI のモデル(2026-11-06 岡本さん)。相談の整理・お知らせは OpenAI、翻訳は xAI(Grok)。鍵は Secret で、なければ AI を使わない
        "AI_OPENAI_MODEL": "gpt-6-luna",
        // gpt-6-luna の既定は medium で遅い。「近いもの」の 8 秒に収まるかは Staging で測って決める
        "AI_OPENAI_REASONING_EFFORT": "low",
        // 翻訳は Grok の最新(別名 grok-latest。2026-11-19 岡本さん「grok-4.7 に替えてよい」、そのとき grok-4.7 を指していた)。
        // 推論する版なので考える量を low にする(同じ 6 文で 1 文 2.4〜5.2 秒。既定のままだと 5〜11.5 秒)
        "AI_XAI_MODEL": "grok-latest",
        "AI_XAI_REASONING_EFFORT": "low",
        // 支援団体の提案の候補を相談の意味で引く埋め込み(#148、2026-11-19)。保存したベクトルと同じモデルで検索するので版を明示する。
        // 上げるときは scripts/embed-directory-entries.mts で全件を作り直してから、ここを替える
        "AI_EMBEDDING_MODEL": "text-embedding-3-small"
      },
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "samasama-app-staging" }],
      // 毎日 JST 2:00(UTC 17:00)。式を変えるときは worker/index.ts の CRON_ROUTES も直す
      "triggers": { "crons": ["0 17 * * *"] }
    },
    "production": {
      "name": "samasama-app-production",
      "vars": {
        "APP_ENV": "production",
        // staging と同じ値にそろえる(知らせのメールは本番の鍵を Secret に入れるまで送らない)
        "NOTIFY_FROM_EMAIL": "明日もsamasama <no-reply@samasama.site>",
        "AI_OPENAI_MODEL": "gpt-6-luna",
        "AI_OPENAI_REASONING_EFFORT": "low",
        "AI_XAI_MODEL": "grok-latest",
        "AI_XAI_REASONING_EFFORT": "low",
        "AI_EMBEDDING_MODEL": "text-embedding-3-small"
      },
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "samasama-app-production" }],
      "triggers": { "crons": ["0 17 * * *"] }
    }
  }
}
