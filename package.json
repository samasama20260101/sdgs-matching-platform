{
  "name": "sdgs-matching-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "tsx scripts/check-i18n-keys.ts",
    "test:units": "node scripts/run-unit-tests.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview --env staging",
    "deploy:cf:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:cf:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.2",
    "@supabase/supabase-js": "^2.93.1",
    "lucide-react": "^0.563.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "exceljs": "^4.4.0",
    "shadcn": "^3.8.4",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
