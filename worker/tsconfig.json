{
  // Workers の入口だけの型チェック。型は `npm run cf-typegen`(wrangler types)で作る cloudflare-env.d.ts から読む
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["./*.ts", "../cloudflare-env.d.ts"]
}
